# Backend API server configuration. Copy to .env and fill in.
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Gemini
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_TEXT_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-4-hydrogen
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Supabase (service role key is server-side only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string, used only by `npm run migrate` (Project Settings > Database)
DATABASE_URL=

# Secrets: at least 32 chars. AUTH_SECRET signs session tokens. CRON_SECRET guards POST /api/pipeline/batch.
AUTH_SECRET=
CRON_SECRET=

# Reality Graph (Relate by Neo4j embedded persistent store)
RELATE_DATABASE_PATH=data/reality

# Primary events source (https://gnews.io). Leave empty to use GDELT only.
GNEWS_API_KEY=

# Live voice limits per user per IST day, and the cap on one session's model tokens and tool calls.
VOICE_SESSIONS_PER_DAY=2
VOICE_TOKENS_PER_SESSION=2000000
VOICE_TOKENS_PER_DAY=4000000
# Look-back window of the briefing and Lens in days, and an optional end date (ISO). Set only to replay the dated NVIDIA demo.
BRIEFING_WINDOW_DAYS=14
# BRIEFING_WINDOW_END=2025-05-30T00:00:00Z
VOICE_MAX_TOOL_CALLS=60


# Email alerts (optional). Render's free tier blocks ports 25/465/587, so use a relay that accepts 2525 (e.g. Brevo free plan).
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Ambition Gazette <you@your-verified-sender.com>
# Public URL of this API (Render), used by the one-tap buttons in emails.
API_PUBLIC_URL=
