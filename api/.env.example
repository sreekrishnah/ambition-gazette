# Backend API server configuration. Copy to .env and fill in.
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Gemini
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Supabase (service role key is server-side only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string, used only by `npm run migrate` (Project Settings > Database)
DATABASE_URL=

# Secrets: at least 32 chars. AUTH_SECRET signs session tokens. CRON_SECRET guards POST /api/pipeline/batch.
AUTH_SECRET=
CRON_SECRET=

# Primary events source (https://gnews.io). Leave empty to use GDELT only.
GNEWS_API_KEY=

# Live voice limits per user per IST day, and the cap on one session's model tokens and tool calls.
VOICE_SESSIONS_PER_DAY=2
VOICE_TOKENS_PER_SESSION=600000
VOICE_TOKENS_PER_DAY=1200000
VOICE_MAX_TOOL_CALLS=60

