# Frontend App Configuration
PORT=3000

# Browser -> API origin. Used only for the live voice socket (socket.io namespace /live).
NEXT_PUBLIC_API_URL=http://localhost:5000

# Server -> API origin. Used by server actions and the same-origin /api proxy route.
# Falls back to NEXT_PUBLIC_API_URL when unset.
INTERNAL_API_URL=http://localhost:5000
